  "proposedMigration": {
    "ReleaseTrack": {
      "legacyId": "externalIds.legacyRegistry",
      "title": "trackTitle -> title",
      "realm": "realmId -> realmId",
      "audio": "trackUrl -> legacy/imported audio asset or audioUrl, depending current canonical storage",
      "metadata": [
        "key",
        "bpm",
        "energy",
        "vibe",
        "bestUse",
        "notes",
        "status"
      ],
      "gating": "visibility -> accessTier/accessPolicy (public | signup | premium); do NOT collapse into showInNexus",
      "legacyEditorial": "role/isFeatured/isFlagship/isRealmAnchor/isPublicPick -> migration metadata only; owner/editorial review decides current Nexus state"
    },
    "ReleaseWorld": {
      "releaseProjectId": "group tracks into canonical release worlds when present",
      "legacyStandaloneTracks": "create/attach to canonical single ReleaseWorld where appropriate"
    },
    "ReleaseAsset": {
      "trackUrl": "audio asset/import reference",
      "artworkUrl": "collection/release artwork where appropriate"
    },
    "CollectionOrExperience": {
      "musicCollections": "preserve as curated collection/playlist data, not as duplicate tracks",
      "isActive": "preserve active/inactive collection state"
    }
  }
